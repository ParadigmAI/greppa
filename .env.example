# Port exposed on the host (container always listens on 3000 internally)
APP_PORT=3000

# Basic-auth password for GET /api/waitlist/export (CSV download).
# Required — the app will fail to start without it.
WAITLIST_EXPORT_PASSWORD=change-me

# Email notification on each waitlist signup, sent via Gmail SMTP.
# GMAIL_USER: the Gmail address to send FROM (and the default recipient).
# GMAIL_APP_PASSWORD: a 16-character App Password for that account —
#   NOT your regular Gmail password. Generate one at
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification
#   to be enabled on the account first).
# If these are left unset, the app still works — it just skips sending
# the notification email and logs a warning.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Who receives the notification email. Defaults to GMAIL_USER if unset.
NOTIFY_EMAIL=mj.jayathilaka@gmail.com
